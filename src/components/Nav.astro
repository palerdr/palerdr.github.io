---
import { profile, links, tabs, type TabId } from '../data/site';

interface Props {
  /** The tab this page belongs to. The sidebar shows it in bold. Omit it on the clock page. */
  active?: TabId;
  /** The mark this page hangs off. The hand leaves from this mark on the way back to the clock. */
  home?: { angle: number; transition?: 'sweep' | 'leap' };
}

const { active, home = { angle: 0 } } = Astro.props;
const siteBase = import.meta.env.BASE_URL.replace(/\/$/, '');
const homePath = `${siteBase}/`;
const here = Astro.url.pathname;
const onClock = here === homePath;
/** A write-up marks its parent tab as current without claiming to be that page. */
const current = (t: { id: TabId; href: string }) =>
  active === t.id ? (here === t.href ? 'page' : 'true') : undefined;
const homeTransition = home.transition ?? 'sweep';
---

<aside class="sidebar" data-nav>
  <div class="sidebar-inner">
    <p class="name">
      <a href={homePath} data-angle={home.angle} data-transition={homeTransition}>{profile.name}</a>
    </p>

    <nav aria-label="Pages">
      <ul class="tabs">
        <li>
          <a
            href={homePath}
            aria-current={onClock ? 'page' : undefined}
            data-angle={home.angle}
            data-transition={homeTransition}
          >
            Home
          </a>
        </li>
        {
          tabs.map((t) => (
            <li>
              <a href={t.href} aria-current={current(t)} data-angle={t.angle}>
                {t.label}
              </a>
            </li>
          ))
        }
      </ul>

      <ul class="tabs ext">
        <li><a href={links.github}>GitHub</a></li>
        <li><a href={links.linkedin}>LinkedIn</a></li>
        <li><a href={links.resume} data-astro-reload>Résumé</a></li>
      </ul>
    </nav>
  </div>
</aside>

<style>
  /* Hyde's sidebar sits above the content on a phone. From 48em up it becomes a
     fixed column beside the content, and the name and tabs rest on its bottom edge. */
  .sidebar {
    padding: 2rem max(1rem, 16px) 1.5rem;
    text-align: center;
    background: var(--paper);
    border-bottom: 1px solid var(--line);
  }

  .name {
    margin: 0 0 1rem;
    font-family: var(--font-title), var(--font-body), serif;
    font-size: 2.6rem;
    line-height: 1.1;
  }

  .name a {
    color: var(--ink);
    text-decoration: none;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0 1rem;
  }

  .ext {
    margin-top: 0.25rem;
  }

  .tabs a {
    display: block;
    line-height: 1.75;
    color: var(--ink);
    text-decoration: none;
  }

  .tabs a:hover,
  .tabs a:focus-visible {
    text-decoration: underline;
    text-decoration-color: currentColor;
  }

  .tabs a[aria-current] {
    font-weight: 700;
  }

  @media (min-width: 48em) {
    .sidebar {
      position: fixed;
      top: 0;
      bottom: 0;
      left: 0;
      z-index: 50;
      display: flex;
      flex-direction: column;
      overflow-y: auto;
      width: var(--sidebar);
      padding: 0;
      text-align: left;
      border-bottom: 0;
      border-right: 1px solid var(--line);
    }

    /* Resting on the bottom edge. A short window scrolls the column so the name
       stays reachable. */
    .sidebar-inner {
      margin-top: auto;
      padding: 1.5rem;
    }

    ul {
      display: block;
    }

    .ext {
      margin-top: 1rem;
    }
  }
</style>
