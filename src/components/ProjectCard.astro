---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'projects'>;
  index: number;
}

const { entry, index } = Astro.props;
const { title, tagline, summary, award, stats, links, writeup } = entry.data;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const panel = `panel-${entry.id}`;
---

<article class="card" data-card data-reveal data-first={index === 0 ? '' : undefined}>
  <button class="head" type="button" data-toggle aria-expanded="true" aria-controls={panel}>
    <span class="headings">
      <span class="title">{title}</span>
      <span class="tagline">{tagline}</span>
      {award && <span class="award">{award}</span>}
    </span>
    <span class="chevron" aria-hidden="true"></span>
  </button>

  <div class="panel" id={panel} data-panel>
    <div class="panel-inner">
      <p class="summary">{summary}</p>

      {
        stats.length > 0 && (
          <dl class="stats">
            {stats.map((s) => (
              <div class="plate">
                <dt class="value">{s.value}</dt>
                <dd class="label">{s.label}</dd>
              </div>
            ))}
          </dl>
        )
      }

      <p class="links">
        {writeup && <a class="primary" href={`${base}/projects/${entry.id}`}>Project →</a>}
        {links.map((l) => <a href={l.href}>{l.label} ↗</a>)}
      </p>
    </div>
  </div>
</article>

<style>
  .card {
    position: relative;
    border-top: 1px solid var(--line);
    background: var(--paper);
    transition: border-color 0.35s var(--ease);
  }

  .card:last-of-type {
    border-bottom: 1px solid var(--line);
  }

  .card:hover,
  .card[data-open] {
    border-top-color: var(--line-strong);
  }

  .head {
    all: unset;
    box-sizing: border-box;
    display: flex;
    align-items: flex-start;
    gap: 1.5rem;
    width: 100%;
    cursor: pointer;
    padding: 1.9rem 0 1.4rem;
  }

  .head:focus-visible {
    outline: 2px solid var(--tint);
    outline-offset: -4px;
  }

  .headings {
    display: grid;
    gap: 0.4rem;
    flex: 1;
    min-width: 0;
  }

  .title {
    font-size: var(--step-2);
    font-weight: 700;
    line-height: 1.1;
  }

  .tagline {
    font-size: var(--step-1);
    line-height: 1.35;
    max-width: 42ch;
  }

  .award {
    font-weight: 700;
  }

  .chevron {
    flex: none;
    width: 0.6rem;
    height: 0.6rem;
    margin-top: 0.7rem;
    border-right: 1px solid var(--ink-dim);
    border-bottom: 1px solid var(--ink-dim);
    rotate: 45deg;
    transition: rotate 0.4s var(--ease), border-color 0.3s var(--ease);
  }

  .card[data-open] .chevron {
    rotate: 225deg;
    border-color: var(--tint);
  }

  /* 0fr → 1fr animates cleanly and needs no measured height. */
  .panel {
    display: grid;
    grid-template-rows: 1fr;
    transition: grid-template-rows 0.45s var(--ease);
  }

  .card[data-collapsed] .panel {
    grid-template-rows: 0fr;
  }

  .panel-inner {
    overflow: hidden;
  }

  .summary {
    max-width: var(--measure);
    margin: 0 0 1.5rem;
  }

  /* The metrics, written out in one plain box: the figure in bold, then what it
     measures. */
  .stats {
    display: grid;
    gap: 0.35rem;
    margin: 0 0 1.5rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--line-strong);
  }

  .plate {
    min-width: 0;
  }

  .value,
  .label {
    display: inline;
    margin: 0;
  }

  .value {
    margin-right: 0.35em;
    font-weight: 700;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
    margin: 0;
    padding-bottom: 2.25rem;
    text-transform: none;
    letter-spacing: 0.03em;
  }

  .links a {
    text-decoration: none;
    border-bottom: 1px solid var(--line-strong);
    padding-bottom: 0.15rem;
  }

  .links a:hover {
    border-bottom-color: currentColor;
  }

  .primary {
    font-weight: 700;
  }
</style>

<script>
  import { allLive } from '../scripts/live';

  document.addEventListener('astro:page-load', () => {
    for (const card of allLive<HTMLElement>('[data-card]')) {
      const toggle = card.querySelector<HTMLButtonElement>('[data-toggle]');
      if (!toggle) continue;

      const setOpen = (open: boolean) => {
        card.toggleAttribute('data-open', open);
        card.toggleAttribute('data-collapsed', !open);
        toggle.setAttribute('aria-expanded', String(open));
      };

      // Markup ships expanded so the content survives without JS. Collapse all
      // but the first once we know scripting is available.
      setOpen(card.dataset.first !== undefined);

      toggle.addEventListener('click', () => setOpen(!card.hasAttribute('data-open')));

    }
  });
</script>
