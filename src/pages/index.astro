---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import ProjectCard from '../components/ProjectCard.astro';
import RoleEntry from '../components/RoleEntry.astro';
import ClockFace from '../components/ClockFace.astro';
import { profile, links, skills, experience, education } from '../data/site';

const projects = (await getCollection('projects', ({ data }) => data.listed)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Base title={`${profile.name} — Computer Science & Data Science Portfolio`}>
  <ClockFace />

  <Section id="intro" num="01" label="Intro">
    <h1 class="lede" data-reveal>{profile.tagline}</h1>

    <div class="intro-grid">
      <div class="blurb" data-reveal>
        {profile.blurb.map((para) => <p>{para}</p>)}
      </div>

      <dl class="skills slab" data-reveal>
        {
          skills.map((group) => (
            <div class="group">
              <dt class="mono">{group.label}</dt>
              <dd>{group.items.join(' · ')}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </Section>

  <Section id="experience" num="02" label="Experience" heading="Where I’ve worked">
    {experience.map((role) => <RoleEntry role={role} />)}

    <div class="education slab" data-reveal>
      <p class="mono kicker">Education</p>
      <h3>{education.school}</h3>
      <p class="degree">
        {education.degree}
        <span class="dot" aria-hidden="true"></span>
        GPA {education.gpa}
        <span class="dot" aria-hidden="true"></span>
        <span class="mono">{education.dates}</span>
      </p>
      <p class="coursework">
        <span class="mono kicker">Coursework</span>
        {education.coursework.join(' · ')}
      </p>
      <p class="coursework">
        <span class="mono kicker">In progress</span>
        {education.inProgress.join(' · ')}
      </p>
    </div>
  </Section>

  <Section id="projects" num="03" label="Projects" heading="Selected projects">
    {projects.map((entry, i) => <ProjectCard entry={entry} index={i} />)}
  </Section>

  <Section id="contact" num="04" label="Contact" heading="Get in touch">
    <div class="contact">
      <p class="prose lead" data-reveal>
        Outside of work I play tournament poker, lift, and climb. I took third in the Citadel
        $2K Guaranteed and third in the Jane Street Freeroll with the Cornell Poker Club. The
        rest of my time goes to game design and 3D animation. Email is the fastest way to reach
        me.
      </p>
      <ul class="channels slab" data-reveal>
        <li>
          <span class="mono key">Email</span>
          <a href={`mailto:${links.email}`}>{links.email}</a>
        </li>
        <li>
          <span class="mono key">GitHub</span>
          <a href={links.github}>@palerdr</a>
        </li>
        <li>
          <span class="mono key">LinkedIn</span>
          <a href={links.linkedin}>James Cenawood</a>
        </li>
        <li>
          <span class="mono key">Résumé</span>
          <a href={links.resume} data-astro-reload>PDF</a>
        </li>
      </ul>
    </div>
  </Section>
</Base>

<style>
  .lede {
    font-size: var(--step-3);
    max-width: 18ch;
    margin: 0 0 2.5rem;
  }

  .intro-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: 2.5rem 3rem;
    align-items: start;
  }

  .blurb {
    font-family: var(--font-serif), serif;
    font-size: var(--step-1);
    line-height: 1.55;
  }

  .blurb p {
    margin: 0 0 0.95em;
    color: var(--ink-dim);
  }

  .blurb p:first-child {
    color: var(--ink);
  }

  .blurb p:last-child {
    margin-bottom: 0;
  }

  .skills {
    margin: 0;
    display: grid;
    gap: 1.4rem;
    padding: 1.5rem 0 0;
  }

  .group dt {
    color: var(--ink-faint);
    margin-bottom: 0.6rem;
    font-size: 0.6875rem;
  }

  .group dd {
    margin: 0;
    color: var(--ink-dim);
    font-size: var(--step--1);
    line-height: 1.7;
  }

  .kicker {
    color: var(--ink-faint);
    font-size: 0.6875rem;
  }

  .education {
    margin-top: 2.25rem;
    padding: 1.75rem 0 0;
  }

  .education h3 {
    font-size: var(--step-2);
    margin-top: 0.7rem;
  }

  .degree {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin: 0.5rem 0 1rem;
    color: var(--ink-dim);
  }

  .dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--line-strong);
    flex: none;
  }

  .coursework {
    font-size: var(--step--1);
    max-width: var(--measure);
    color: var(--ink-faint);
    margin: 0;
  }

  .coursework .kicker {
    margin-right: 0.5rem;
  }

  .coursework + .coursework {
    margin-top: 0.4rem;
  }

  .contact {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 2rem 3rem;
    align-items: start;
  }

  .lead {
    color: var(--ink-dim);
    font-family: var(--font-serif), serif;
    font-size: var(--step-1);
    line-height: 1.55;
  }

  .channels {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }

  .channels li {
    display: grid;
    grid-template-columns: 6rem 1fr;
    gap: 1rem;
    align-items: baseline;
    padding-block: 0.9rem;
    border-bottom: 1px solid var(--line);
  }

  .channels li:last-child {
    border-bottom: 0;
  }

  .key {
    color: var(--ink-faint);
    font-size: 0.6875rem;
  }

  .channels a {
    text-decoration: none;
    border-bottom: 1px solid var(--line-strong);
    padding-bottom: 0.1rem;
  }

  .channels a:hover {
    border-bottom-color: currentColor;
  }

  @media (max-width: 46rem) {
    .intro-grid,
    .contact {
      grid-template-columns: 1fr;
    }
  }
</style>
