---
import type { GetStaticPaths } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Dial from '../../components/Dial.astro';
import Collapse from '../../components/Collapse.astro';
import { profile } from '../../data/site';

interface Props {
  entry: CollectionEntry<'projects'>;
}

export const getStaticPaths: GetStaticPaths = async () => {
  const entries = await getCollection('projects', ({ data }) => data.writeup);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
};

const { entry } = Astro.props;
const { title, tagline, award, year, stack, stats, links } = entry.data;
const { Content } = await render(entry);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const homeClock = `${base}/`;

const clockAngles: Record<string, number> = {
  northwell: 60,
  'surpassing-the-leader': 240,
  algosplit: 300,
};
const returnAngle = clockAngles[entry.id] ?? 0;
const returnTransition = entry.id === 'surpassing-the-leader' ? 'leap' : 'sweep';

/** The dial is the commit mechanic of this specific game, so it only belongs here. */
const showDial = entry.id === 'surpassing-the-leader';
/** Same page: the collapse figure says what three stat plates could not. */
const showCollapse = entry.id === 'surpassing-the-leader';
---

<Base title={`${title} — ${profile.name}`} description={tagline}>
  <article class="wrap">
    <header class="project-header">
      <p class="back mono">
        <a href={homeClock} data-angle={returnAngle} data-transition={returnTransition}>← Back to clock</a>
      </p>
      <div class="heading-line">
        <h1>{title}</h1>
        <p class="tagline">{tagline}</p>
      </div>
      {award && <p class="award mono">{award}</p>}

      <div class="overview">
        <dl class="facts">
          <div>
            <dt class="mono kicker">Year</dt>
            <dd>{year}</dd>
          </div>
          <div>
            <dt class="mono kicker">Built with</dt>
            <dd>{stack.join(' · ')}</dd>
          </div>
        </dl>

        {
          links.length > 0 && (
            <ul class="links mono">
              {links.map((l) => (
                <li><a href={l.href}>{l.label} ↗</a></li>
              ))}
            </ul>
          )
        }
      </div>

      {
        !showCollapse && stats.length > 0 && (
          <dl class="stats">
            {stats.map((s) => (
              <div class="plate">
                <dt class="value">{s.value}</dt>
                <dd class="label">{s.label}</dd>
              </div>
            ))}
          </dl>
        )
      }
    </header>

    {showCollapse && <Collapse />}

    {
      showDial && (
        <div class="dial-mount" data-reveal>
          <Dial />
        </div>
      )
    }

    <div class="prose body">
      <Content />
    </div>

    <p class="foot mono">
      <a href={homeClock} data-angle={returnAngle} data-transition={returnTransition}>← Back to clock</a>
    </p>
  </article>
</Base>

<style>
  article {
    padding-block: clamp(2.5rem, 7vw, 5rem) 0;
  }

  .project-header {
    max-width: 50rem;
  }

  .back,
  .foot {
    color: var(--ink-faint);
  }

  .back a,
  .foot a {
    text-decoration: none;
  }

  .back a:hover,
  .foot a:hover {
    color: var(--ink);
  }

  .foot {
    margin: 4rem 0 0;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }

  h1 {
    font-size: var(--step-3);
    max-width: 20ch;
  }

  .heading-line {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1.25rem;
    margin-top: 1.75rem;
  }

  .tagline {
    flex: 1 1 24rem;
    font-size: var(--step-1);
    color: var(--ink-dim);
    margin: 0;
    max-width: 44ch;
  }

  .award {
    display: inline-flex;
    align-items: center;
    max-width: 100%;
    padding: 0.35rem 0.65rem 0.3rem;
    border-left: 3px solid var(--leap);
    background: var(--paper-deep);
    color: var(--ink);
    text-transform: none;
    letter-spacing: 0.025em;
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1.4;
    margin: 1.1rem 0 0;
  }

  .kicker {
    color: var(--ink-faint);
    font-size: 0.6875rem;
  }

  .overview {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem 1.75rem;
    margin-top: 2.25rem;
    padding-block: 0.85rem;
    border-block: 1px solid var(--line);
  }

  .facts {
    display: flex;
    flex: 1 1 auto;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem 1.75rem;
    margin: 0;
  }

  .facts > div {
    display: inline-flex;
    gap: 0.45rem;
    align-items: baseline;
  }

  .facts dt {
    margin: 0;
    white-space: nowrap;
  }

  .facts dd {
    margin: 0;
    font-size: var(--step--1);
    line-height: 1.6;
    color: var(--ink-dim);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
    text-transform: none;
    letter-spacing: 0.03em;
  }

  .links a {
    text-decoration: none;
    color: var(--ink-dim);
    border-bottom: 1px solid var(--line-strong);
    padding-bottom: 0.15rem;
  }

  .links a:hover {
    color: var(--ink);
    border-bottom-color: currentColor;
  }

  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2.5rem;
    margin: 1.5rem 0 0;
  }

  .plate {
    display: flex;
    flex: 1 1 22rem;
    align-items: baseline;
    gap: 0.65rem;
    min-width: 0;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .value {
    flex: none;
    font-size: var(--step-2);
    font-weight: 700;
    line-height: 1.1;
  }

  .label {
    flex: 1;
    display: inline-block;
    max-width: 100%;
    margin: 0;
    padding: 0.35rem 0.65rem 0.3rem;
    border-left: 3px solid var(--leap);
    background: var(--paper-deep);
    font-size: var(--step--1);
    font-weight: 600;
    line-height: 1.45;
    color: var(--ink);
  }

  .dial-mount {
    display: grid;
    place-items: center;
    padding: 2.5rem 0 3rem;
    border-block: 1px solid var(--line);
  }

  .body {
    margin-top: 3rem;
    color: var(--ink-dim);
    font-family: var(--font-serif), serif;
    font-size: var(--step-1);
    line-height: 1.6;
  }

  .body :global(h2) {
    font-size: var(--step-2);
    color: var(--ink);
    margin: 3.25rem 0 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .body :global(h2:first-child) {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }

  .body :global(img) {
    display: block;
    width: 100%;
    height: auto;
    margin: 1.5rem 0;
    border: 1px solid var(--line);
  }

  .body :global(strong) {
    font-weight: 600;
    color: var(--ink);
  }

  .body :global(em) {
    color: var(--ink);
  }

  .body :global(pre) {
    background: var(--paper-deep);
    border: 1px solid var(--line);
    padding: 1rem 1.25rem;
    overflow-x: auto;
    font-size: var(--step--1);
  }

  .body :global(code) {
    font-family: var(--font-mono), monospace;
    font-size: 0.88em;
  }

  .body :global(:not(pre) > code) {
    background: var(--paper-deep);
    border: 1px solid var(--line);
    padding: 0.08em 0.35em;
    color: var(--ink);
  }

</style>
