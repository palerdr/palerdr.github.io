---
import type { GetStaticPaths } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Dial from '../../components/Dial.astro';
import Collapse from '../../components/Collapse.astro';
import { profile } from '../../data/site';
import 'katex/dist/katex.min.css';

interface Props {
  entry: CollectionEntry<'projects'>;
}

export const getStaticPaths: GetStaticPaths = async () => {
  const entries = await getCollection('projects', ({ data }) => data.writeup);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
};

const { entry } = Astro.props;
const { title, tagline, award, year, stack, stats, links, listed } = entry.data;
const { Content } = await render(entry);

const clockAngles: Record<string, number> = {
  northwell: 60,
  'surpassing-the-leader': 240,
  algosplit: 300,
};
const returnAngle = clockAngles[entry.id] ?? 0;
const returnTransition = entry.id === 'surpassing-the-leader' ? 'leap' : 'sweep';

/** The dial is the commit mechanic of this specific game, so it only belongs here. */
const showDial = entry.id === 'surpassing-the-leader';
/** Same page: the collapse figure says what three stat plates could not. */
const showCollapse = entry.id === 'surpassing-the-leader';
---

<Base
  title={`${title} — ${profile.name}`}
  description={tagline}
  tab={listed ? 'projects' : 'experience'}
  home={{ angle: returnAngle, transition: returnTransition }}
>
  <article class="page">
    <header class="project-header">
      <h1>{title}</h1>
      <p class="tagline">{tagline}</p>
      {award && <p class="award">{award}</p>}

      <p class="facts">{year} · {stack.join(', ')}</p>

      {
        links.length > 0 && (
          <ul class="links">
            {links.map((l) => (
              <li><a href={l.href}>{l.label} ↗</a></li>
            ))}
          </ul>
        )
      }

      {
        !showCollapse && stats.length > 0 && (
          <dl class="stats">
            {stats.map((s) => (
              <div class="plate">
                <dt class="value">{s.value}</dt>
                <dd class="label">{s.label}</dd>
              </div>
            ))}
          </dl>
        )
      }
    </header>

    {showCollapse && <Collapse />}

    {
      showDial && (
        <div class="dial-mount" data-reveal>
          <Dial />
        </div>
      )
    }

    <div class="body">
      <Content />
    </div>
  </article>
</Base>

<style>
  h1 {
    max-width: 24ch;
  }

  .tagline {
    font-size: var(--step-1);
    color: var(--ink-dim);
    margin: 0.35rem 0 0;
  }

  .award {
    margin: 0.75rem 0 0;
    color: var(--ink);
    font-weight: 700;
  }

  .facts {
    margin: 1.25rem 0 0;
    color: var(--ink-dim);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0;
  }

  .links a {
    color: var(--ink);
    text-decoration-color: var(--line-strong);
  }

  .links a:hover {
    text-decoration-color: currentColor;
  }

  /* The metrics, written out in one plain box: the figure in bold, then what it
     measures. */
  .stats {
    display: grid;
    gap: 0.35rem;
    margin: 1.5rem 0 0;
    padding: 0.75rem 1rem;
    border: 1px solid var(--line-strong);
    border-radius: 4px;
  }

  .plate {
    min-width: 0;
  }

  .value,
  .label {
    display: inline;
    margin: 0;
  }

  .value {
    margin-right: 0.35em;
    font-weight: 700;
    color: var(--ink);
  }

  .label {
    color: var(--ink-dim);
  }

  .dial-mount {
    display: grid;
    place-items: center;
    margin-top: 2rem;
    padding: 2rem 0;
    border-block: 1px solid var(--line);
  }

  .body {
    margin-top: 2.5rem;
    color: var(--ink-dim);
    container-type: inline-size;
  }

  .body :global(h2) {
    color: var(--ink);
    margin: 2.5rem 0 0.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .body :global(h2:first-child) {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }

  .body :global(img) {
    display: block;
    width: 100%;
    height: auto;
    margin: 1.5rem 0;
    border: 1px solid var(--line);
  }

  /* Charts from scripts/figures sit on the paper with no frame, centred at a
     width that keeps their text near the body size. Dev serves them as
     /_image?href=…svg&f=svg and a build as /_astro/…svg, so the rule matches both. */
  .body :global(img[src*='.svg']) {
    max-width: 36rem;
    margin-inline: auto;
    border: 0;
  }

  .body :global(strong) {
    font-weight: 600;
    color: var(--ink);
  }

  .body :global(em) {
    color: var(--ink);
  }

  .body :global(pre) {
    background: var(--paper-deep);
    border: 1px solid var(--line);
    padding: 1rem 1.25rem;
    overflow-x: auto;
    font-size: var(--step--1);
  }

  .body :global(code) {
    font-family: var(--font-mono), monospace;
    font-size: 0.88em;
  }

  .body :global(:not(pre) > code) {
    background: var(--paper-deep);
    border: 1px solid var(--line);
    padding: 0.08em 0.35em;
    color: var(--ink);
  }

  /* Poole's table: hairline cells. On a phone a wide table scrolls inside the
     column, and the page keeps its width. */
  .body :global(table) {
    display: block;
    width: max-content;
    max-width: 100%;
    overflow-x: auto;
    margin: 0 0 1rem;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }

  .body :global(th),
  .body :global(td) {
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--line);
  }

  .body :global(th) {
    color: var(--ink);
  }

  .body :global(th:not([align])) {
    text-align: left;
  }

  /* Each math display sits centred on its own line. If the column is too narrow
     for it, the display scrolls by itself. */
  .body :global(.katex-display) {
    margin: 1rem 0 1.25rem;
    overflow-x: auto;
    overflow-y: hidden;
    padding-block: 0.25rem;
  }

  .body :global(.katex) {
    color: var(--ink);
    font-size: 1.1em;
  }

  /* The widest rows need about 634px of math at full size. The column beside the
     sidebar and the phone column are both narrower, so displays drop a size step
     whenever the column is. */
  @container (max-width: 660px) {
    .body :global(.katex-display) {
      font-size: 0.75em;
    }
  }

  .body :global(svg.figure) {
    display: block;
    width: 100%;
    height: auto;
    margin: 1.5rem 0;
    font-family: var(--font-body), Helvetica, Arial, sans-serif;
  }

  /* Northwell's agent pipeline. The red path is the wrong-table case. */
  .body :global(.agent-flow) {
    max-width: 26rem;
    margin-inline: auto;
  }

  .body :global(.agent-flow text) {
    font-size: 13.5px;
    fill: var(--ink);
    text-anchor: middle;
  }

  .body :global(.agent-flow text[text-anchor='start']) {
    text-anchor: start;
  }

  .body :global(.agent-flow text[text-anchor='end']) {
    text-anchor: end;
  }

  .body :global(.agent-flow .box) {
    fill: var(--paper);
    stroke: var(--ink);
    stroke-width: 1.5;
  }

  .body :global(.agent-flow .apart) {
    stroke: var(--ink-dim);
    stroke-dasharray: 4 4;
  }

  .body :global(.agent-flow .edge) {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.5;
  }

  .body :global(.agent-flow .head) {
    fill: var(--ink);
  }

  .body :global(.agent-flow .red) {
    stroke: var(--leap);
    stroke-width: 2.5;
  }

  .body :global(.agent-flow .head.red) {
    fill: var(--leap);
    stroke: none;
  }

  .body :global(.agent-flow text.red) {
    fill: var(--leap);
    stroke: none;
    font-weight: 700;
  }

</style>
