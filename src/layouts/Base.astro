---
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import Nav from '../components/Nav.astro';
import TransitionStage from '../components/TransitionStage.astro';
import { links, profile } from '../data/site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = profile.name,
  description = profile.description,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const siteUrl = new URL('/', Astro.site).href;
const isHome = canonical.href === siteUrl;
const structuredData = isHome
  ? {
      '@context': 'https://schema.org',
      '@type': 'ProfilePage',
      url: siteUrl,
      name: `${profile.name} — Computer Science Portfolio`,
      description: profile.description,
      mainEntity: {
        '@id': `${siteUrl}#person`,
        '@type': 'Person',
        name: profile.name,
        alternateName: 'palerdr',
        url: siteUrl,
        description: profile.description,
        sameAs: [links.github, links.linkedin],
        affiliation: {
          '@type': 'CollegeOrUniversity',
          name: 'Cornell University',
          url: 'https://www.cornell.edu/',
        },
        knowsAbout: [
          'Computer science',
          'Data science',
          'Artificial intelligence',
          'Optimization',
          'Mathematical modeling',
        ],
      },
    }
  : undefined;
---

<!doctype html>
<!-- The stage owns all transition motion, so Astro's default cross-fade is off. -->
<html lang="en" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href={`${base}/sitemap-index.xml`} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={`${profile.name} — Portfolio`} />
    <meta name="twitter:card" content="summary" />
    {
      structuredData && (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
      )
    }
    <Font cssVariable="--font-body" preload />
    <ClientRouter />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <TransitionStage />
    <Nav />
    <main id="main">
      <slot />
    </main>
    <footer>
      <div class="wrap footer-inner">
        <p class="mono">© {new Date().getFullYear()} {profile.name}</p>
        <p class="mono">
          Built with <a href="https://astro.build">Astro</a>
          <span class="sep" aria-hidden="true"></span>
          <a href="#top">Back to top ↑</a>
        </p>
      </div>
    </footer>

    <style>
      footer {
        border-top: 1px solid var(--line);
        margin-top: 6rem;
        padding-block: 2rem 3rem;
        background: var(--paper);
      }

      .footer-inner {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem 2rem;
        justify-content: space-between;
        align-items: center;
        color: var(--ink-faint);
      }

      .footer-inner p {
        margin: 0;
        display: flex;
        align-items: center;
        gap: 0.75rem;
      }

      .footer-inner a {
        text-decoration: none;
        color: var(--ink-dim);
      }

      .footer-inner a:hover {
        color: var(--tint);
      }

      .sep {
        width: 4px;
        height: 4px;
        border-radius: 50%;
        background: var(--line-strong);
      }
    </style>

    <script>
      // Runs on first load and again after every client-side navigation.
      document.addEventListener('astro:page-load', () => {
        const revealables = document.querySelectorAll<HTMLElement>('[data-reveal]');
        if (revealables.length === 0) return;

        if (!('IntersectionObserver' in window)) {
          for (const el of revealables) el.classList.add('is-in');
          return;
        }

        const observer = new IntersectionObserver(
          (entries) => {
            entries
              .filter((entry) => entry.isIntersecting)
              .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)
              .forEach((entry, i) => {
                const el = entry.target as HTMLElement;
                el.style.setProperty('--reveal-delay', `${Math.min(i, 3) * 70}ms`);
                el.classList.add('is-in');
                observer.unobserve(el);
              });
          },
          { rootMargin: '0px 0px -12% 0px', threshold: 0.08 },
        );

        for (const el of revealables) observer.observe(el);
      });
    </script>
  </body>
</html>
